;; utsushi（映し）— 時間ベースメディア（動画/音声）の純 cljc + EDN ライブラリ。
;; 設計 SSoT: 90-docs/adr/2606272200-utsushi-video-edn-filtergraph.md (ADR-2606272200)
;;
;; 方針（ADR §0、2026-07-08 改訂 — reverse-domain split）:
;;   ① コンテナ demux/mux/remux/bytes/blob … org-iso-isobmff へ抽出済み（ISO/IEC 14496-12、
;;      kasane.isobmff と統合）。utsushi はそれに依存する filtergraph オーケストレータ。
;;   ② ビットストリーム（NAL/SPS/ADTS/Opus framing）… org-iso-h264/org-iso-aac/org-ietf-opus
;;      へ新規実装として切り出し済み（utsushi.bitstream は未実装 TODO stub だったため）。
;;      utsushi.codec は org-iso-h264 だけを消費する（avcC埋め込みSPSの実解析）。
;;      AAC/Opusは demux 済みsampleに対して適用対象が存在しないため未配線
;;      （理由は utsushi.codec のdocstring参照）。
;;   ③ codec カーネル        … R0 opaque / R1 capability-gated native（kotoba-clj host word）
;;   ④ filtergraph           … kotoba defgraph への射影（データ）、Pregel BSP 実行
;; utsushi 自身に残るのは filtergraph オーケストレーション + capability/effect/gas モデルの
;; kotoba 鏡写しという「utsushi 固有の知的財産」だけ。コンテナ/コーデック仕様の実装は
;; 各 reverse-domain repo に委ねる（com-junkawasaki/root ADR 前例2607072500）。
;;
;; decode-state Store（ADR-2607122000 Migration手順5）: org-iso-h264 を
;; a6ed858（framing/SPS/PPS のみ）→ daccb23（h264.decode/decode-idr-frame、
;; 実画素 baseline intra decode 追加、Wave 3）へ更新。langchain は
;; utsushi.codec.store の `:db-api` 注入パターン（MemStore ≡ DatomicStore
;; contract、actor 系と同型）の手本かつ実体（langchain.db/api）。
;;
;; multi-frame decode（GOP: IDR + P-frames）: org-iso-h264 を 55ffcdd → 9bff54f
;; （main tip、34 commits ahead / 0 behind、merge-base == 55ffcdd = 純 fast-forward。
;; `gh api repos/kotoba-lang/org-iso-h264/compare/55ffcdd...9bff54f` で確認）へ更新。
;; 55ffcdd には `h264.decode/decode-gop` が存在せず、decode できるのは 1 枚目の IDR
;; だけだった。9bff54f の decode-gop は 1 本の Annex B ストリームから全ピクチャを
;; 順に decode し、各 P-slice は直前の復号ピクチャを単一参照フレームにする。
;; 配線は utsushi.pipeline.mp4-h264/decode-h264-frames。
;;
;; h264-mp4 encode pipeline（画素→H.264 encode→MP4 mux、mp4-h264 の逆方向）:
;; org-iso-h264 を daccb23 → 55ffcdd（`h264.encode`/`encode-idr-luma-frame`
;; namespace そのもの — luma+chroma Intra_16x16 baseline encoder、Wave 5）へ
;; 更新。daccb23 には `h264.encode` 自体が存在しない（この namespace は
;; c107b41/2839cf5 で初めて追加された）ため、encode 方向の配線には必須の更新。
{:paths ["src" "resources"]
 :deps  {io.github.kotoba-lang/org-iso-isobmff {:git/sha "50fbdbbeb5be30d8cab63877b220b7079a23b4a1"}
         io.github.kotoba-lang/org-iso-h264    {:git/sha "9bff54f1f1d7f24f9ff968285a2fc59e376fc9e5"}
         io.github.kotoba-lang/langchain       {:git/sha "0f966d06c93d7fc76b0790fdece4c391dc257eb1"}}
 :aliases
 {;; ffmpeg comparison benchmark — see bench/ffmpeg-comparison/README.md.
  ;; perfgate owns the statistics and the refusals; nothing here computes a
  ;; mean and calls it a result.
  :bench {:extra-paths ["bench/ffmpeg-comparison/src"]
          :extra-deps {io.github.kotoba-lang/perfgate
                       {:git/sha "d4417d77c2333047dd4e478675e5ed13e1c6b1b8"}}
          :main-opts ["-m" "utsushi.bench.ffmpeg-comparison"]}
  ;; Fixture regeneration needs the same extra path but a different -main.
  ;; It gets its own alias because `-M:bench -m other.ns` does NOT override an
  ;; alias's `:main-opts` — the extra args are appended as ARGUMENTS to the
  ;; alias's main, so that invocation silently runs the benchmark instead.
  ;; The README documented exactly that non-working command until 2026-08-30.
  :bench-fixtures {:extra-paths ["bench/ffmpeg-comparison/src"]
                   :main-opts ["-m" "utsushi.bench.generate-fixtures"]}
  ;; Where the per-frame time goes. Diagnostic only — it times nothing and
  ;; gates nothing, and it is NOT run inside the comparison, because a
  ;; profiler attached to a timed interval measures the profiler.
  :bench-profile {:extra-paths ["bench/ffmpeg-comparison/src"]
                  :extra-deps {io.github.kotoba-lang/perfgate
                               {:git/sha "d4417d77c2333047dd4e478675e5ed13e1c6b1b8"}}
                  :main-opts ["-m" "utsushi.bench.profile"]}
  ;; the bench's REFUSAL logic is on the ordinary test path (its timing is
  ;; not) — a harness that stays silent when it could not measure is the
  ;; failure worth a test on every run.
  :test {:extra-paths ["test" "bench/ffmpeg-comparison/src"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      io.github.kotoba-lang/perfgate
                      {:git/sha "d4417d77c2333047dd4e478675e5ed13e1c6b1b8"}}
         :main-opts ["-m" "cognitect.test-runner"]}
       ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
       :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "bench/ffmpeg-comparison/src"
                     "--fail-level" "error"]}}}
