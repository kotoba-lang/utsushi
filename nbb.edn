;; kbb/nbb engine config — deps.edn から byte-for-byte 複写 (AGENTS.md 規則:
;; sha も :paths も隣の project file から複写し、推測しない)。
;; kbb は Maven/git 座標を解決しないので git dep を :deps に宣言する。
{:paths ["src" "resources" "test" "bench/ffmpeg-comparison/src" "bench/decode-cost-attribution/src" "machine-shim/src" "perfgate-shim/src"]
 :deps {
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn {:git/sha "79dba32c8892058842c57783f06a2dfe4601aeb0"}
       io.github.kotoba-lang/text        {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
        io.github.kotoba-lang/org-iso-isobmff {:git/sha "50fbdbbeb5be30d8cab63877b220b7079a23b4a1"}
        io.github.kotoba-lang/org-iso-h264    {:git/sha "de99083a368083f42c096f59388dc5798d85fbaf"}
        io.github.kotoba-lang/langchain       {:git/sha "0f966d06c93d7fc76b0790fdece4c391dc257eb1"}}}
